/*
 * 文件标注：AI 生成 —— 人体部位多边形路径数据（纯本地数据，无网络）
 *
 * 数据层 · BodyPathData
 * 真人肌肉轮廓造型（参考健体人体照片）：头部、斜方肩部、双叶胸肌、收腰腹部、
 * 二头肌/前臂手臂、臀部、大腿-小腿渐变腿型；背面为 V 型背阔肌。
 * 点坐标按归一化 0–100 存储，绘制时按画布尺寸缩放。
 * 成对部位（手臂/腿）用「左/右」后缀键区分，groupOf() 归并到 7 个部位组；
 * 「头」为装饰部位，恒为中性色，不参与热力统计。
 */

export class BodyPathData {
  /** 正面部位路径：键为部位名（成对部位带左/右后缀），值为归一化坐标点串 */
  static getFrontPaths(): Map<string, number[][]> {
    const paths: Map<string, number[][]> = new Map<string, number[][]>();
    // 头（装饰，中性色）
    paths.set('头', [[44, 1], [56, 1], [60, 5], [60, 9], [56, 13], [44, 13], [40, 9], [40, 5]]);
    // 肩（斜方-三角肌：中间微凹、两端圆肩）
    paths.set('肩', [[22, 15], [34, 11], [46, 13], [54, 13], [66, 11], [78, 15], [82, 21], [74, 24], [26, 24], [18, 21]]);
    // 胸（双叶胸肌，中间胸骨凹线）
    paths.set('胸', [[28, 26], [47, 25], [50, 28], [53, 25], [72, 26], [73, 33], [64, 41], [53, 39], [50, 37], [47, 39], [36, 41], [27, 33]]);
    // 腹（收腰矩形，上宽下窄）
    paths.set('腹', [[39, 43], [61, 43], [59, 51], [56, 59], [44, 59], [41, 51]]);
    // 臀（半圆外扩）
    paths.set('臀', [[37, 61], [63, 61], [68, 68], [61, 76], [39, 76], [32, 68]]);
    // 手臂（二头肌鼓起 + 前臂收窄，略外张）
    paths.set('手臂左', [[13, 23], [21, 22], [24, 31], [21, 41], [18, 53], [12, 55], [8, 47], [8, 31]]);
    paths.set('手臂右', [[79, 22], [87, 23], [92, 31], [92, 47], [88, 55], [82, 53], [79, 41], [76, 31]]);
    // 腿（大腿宽、膝盖收窄、小腿微鼓）
    paths.set('腿左', [[38, 78], [49, 78], [48, 86], [47, 91], [46, 97], [40, 97], [39, 91], [37, 86]]);
    paths.set('腿右', [[51, 78], [62, 78], [63, 86], [61, 91], [60, 97], [54, 97], [53, 91], [52, 86]]);
    return paths;
  }

  /** 背面部位路径（V 型背阔肌轮廓） */
  static getBackPaths(): Map<string, number[][]> {
    const paths: Map<string, number[][]> = new Map<string, number[][]>();
    paths.set('头', [[44, 1], [56, 1], [60, 5], [60, 9], [56, 13], [44, 13], [40, 9], [40, 5]]);
    paths.set('肩', [[22, 15], [34, 11], [46, 13], [54, 13], [66, 11], [78, 15], [82, 21], [74, 24], [26, 24], [18, 21]]);
    // 背（背阔肌 V 型：上宽下窄收至腰）
    paths.set('背', [[27, 25], [73, 25], [71, 35], [63, 47], [58, 58], [42, 58], [37, 47], [29, 35]]);
    paths.set('臀', [[37, 60], [63, 60], [68, 68], [61, 76], [39, 76], [32, 68]]);
    paths.set('手臂左', [[13, 23], [21, 22], [24, 31], [21, 41], [18, 53], [12, 55], [8, 47], [8, 31]]);
    paths.set('手臂右', [[79, 22], [87, 23], [92, 31], [92, 47], [88, 55], [82, 53], [79, 41], [76, 31]]);
    paths.set('腿左', [[38, 78], [49, 78], [48, 86], [47, 91], [46, 97], [40, 97], [39, 91], [37, 86]]);
    paths.set('腿右', [[51, 78], [62, 78], [63, 86], [61, 91], [60, 97], [54, 97], [53, 91], [52, 86]]);
    return paths;
  }

  /** 路径键 → 部位组名（手臂左/右 → 手臂，腿左/右 → 腿，其余原样） */
  static groupOf(key: string): string {
    if (key === '手臂左' || key === '手臂右') {
      return '手臂';
    }
    if (key === '腿左' || key === '腿右') {
      return '腿';
    }
    return key;
  }

  /** 路径键 → 透视深度因子 z（0 远 1 近；胸/背最前，腿最后；头为装饰不投影放大） */
  static depthOf(key: string): number {
    const group: string = BodyPathData.groupOf(key);
    if (group === '胸') {
      return 1.0;
    }
    if (group === '背') {
      return 0.95;
    }
    if (group === '肩') {
      return 0.9;
    }
    if (group === '腹') {
      return 0.8;
    }
    if (group === '臀') {
      return 0.75;
    }
    if (group === '手臂') {
      return 0.7;
    }
    if (group === '腿') {
      return 0.6;
    }
    return 0.5;
  }
}
